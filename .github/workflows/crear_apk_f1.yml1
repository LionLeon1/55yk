name: Crear APK Apex Life F1

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  compilar:
    runs-on: ubuntu-latest

    steps:
      - name: 1. Descargar repositorio
        uses: actions/checkout@v4

      - name: 2. Descomprimir y preparar archivos del juego
        run: |
          shopt -s nullglob
          zips=(*.zip)
          if [ ${#zips[@]} -gt 0 ]; then
            echo "Descomprimiendo ${zips[0]}..."
            unzip -o "${zips[0]}" -d .
          fi

          if [ -f "apex_life_f1.py" ]; then
            cp apex_life_f1.py main.py
          else
            pys=(*.py)
            if [ ${#pys[@]} -gt 0 ]; then
              cp "${pys[0]}" main.py
            else
              echo "ERROR: No se encontró ningún archivo .zip ni .py en la raíz."
              exit 1
            fi
          fi

      - name: 3. Crear configuración buildozer.spec
        run: |
          cat << 'EOF' > buildozer.spec
          [app]
          title = Apex Life F1
          package.name = apexlifef1
          package.domain = org.apexlife
          source.dir = .
          source.include_exts = py,png,jpg,kv,atlas,json
          version = 2.0
          requirements = python3,kivy==2.3.0
          orientation = landscape
          fullscreen = 1
          android.permissions = INTERNET
          android.api = 33
          android.minapi = 21
          android.archs = arm64-v8a
          android.accept_sdk_license = True

          [buildozer]
          log_level = 2
          warn_on_root = 1
          EOF

      - name: 4. Compilar APK con Buildozer Action
        id: buildozer
        uses: ArtemSBulgakov/buildozer-action@v1
        with:
          workdir: .
          buildozer_version: stable

      - name: 5. Subir APK descargable
        uses: actions/upload-artifact@v4
        with:
          name: apex-life-f1-apk
          path: ${{ steps.buildozer.outputs.filename }}
